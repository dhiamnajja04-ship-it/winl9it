    {
      "name": "Match (Entité 1)",
      "item": [
        {
          "name": "1. Ajouter une correspondance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches"
              ]
            },
            "description": "Crée une correspondance. Le score est calculé par le serveur (30% catégorie, 30% description, 20% lieu, 20% date). L'id créé est enregistré dans la variable d'environnement {{matchId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lostItemId\": \"LOST-001\",\n  \"foundItemId\": \"FOUND-001\",\n  \"category\": \"Accessoires\",\n  \"criteria\": {\n    \"categoryScore\": 100,\n    \"descriptionScore\": 85,\n    \"locationScore\": 90,\n    \"dateScore\": 75\n  },\n  \"notes\": \"Sac à dos noir Eastpak — bibliothèque universitaire\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Score calculé = 88.5\", () => pm.expect(json.data.score).to.eql(88.5));",
                  "pm.environment.set(\"matchId\", json.data._id);",
                  "console.log(\"matchId enregistré :\", json.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Lister les correspondances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
