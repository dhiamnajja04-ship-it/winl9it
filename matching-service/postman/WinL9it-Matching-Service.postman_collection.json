    {
      "name": "Match — Métier",
      "description": "Cycle de vie PROPOSÉ → CONFIRMÉ → RESTITUÉ, rejet automatique des propositions concurrentes, suggestions classées, tableau de bord.",
      "item": [
        {
          "name": "1. Créer la proposition A (score fort)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lostItemId\": \"{{lostRef}}\",\n  \"foundItemId\": \"{{lostRef}}-FOUND-A\",\n  \"category\": \"Électronique\",\n  \"criteria\": {\n    \"categoryScore\": 100,\n    \"descriptionScore\": 85,\n    \"locationScore\": 90,\n    \"dateScore\": 75\n  },\n  \"notes\": \"iPhone 13 bleu — cafétéria\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"lostRef\", \"LOST-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Toujours créée à l'état PROPOSÉ\", () => pm.expect(d.status).to.eql(\"PROPOSÉ\"));",
                  "pm.environment.set(\"matchA\", d._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Créer la proposition B (même objet perdu, score faible)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lostItemId\": \"{{lostRef}}\",\n  \"foundItemId\": \"{{lostRef}}-FOUND-B\",\n  \"category\": \"Électronique\",\n  \"criteria\": {\n    \"categoryScore\": 100,\n    \"descriptionScore\": 40,\n    \"locationScore\": 30,\n    \"dateScore\": 50\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"matchB\", pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Suggestions pour l'objet perdu (classées par score)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/suggestions/{{lostRef}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "suggestions",
                "{{lostRef}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"2 suggestions\", () => pm.expect(r.count).to.eql(2));",
                  "pm.test(\"A en premier, niveau FORT\", () => { pm.expect(r.data[0]._id).to.eql(pm.environment.get(\"matchA\")); pm.expect(r.data[0].niveau).to.eql(\"FORT\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Transition interdite PROPOSÉ → RESTITUÉ → 409",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchA}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchA}}",
                "status"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESTITUÉ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Statut inconnu → 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchA}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchA}}",
                "status"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PERDU\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Confirmer A (B est rejetée automatiquement)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchA}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchA}}",
                "status"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMÉ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"A est CONFIRMÉ\", () => pm.expect(r.data.status).to.eql(\"CONFIRMÉ\"));",
                  "pm.test(\"1 proposition concurrente rejetée\", () => pm.expect(r.autresRejetees).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Vérifier que B est REJETÉ",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchB}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchB}}"
              ]
            },
