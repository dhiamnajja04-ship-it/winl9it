                "api",
                "matches",
                "{{matchId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Bon id\", () => pm.expect(pm.response.json().data._id).to.eql(pm.environment.get(\"matchId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Modifier une correspondance",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
