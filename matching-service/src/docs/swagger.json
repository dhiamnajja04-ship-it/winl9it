{
  "openapi": "3.0.3",
  "info": {
    "title": "WinL9it — Matching Service",
    "version": "1.0.0",
    "description": "CRUD + métier des correspondances (Match) entre objets perdus et retrouvés, des retours utilisateurs (MatchFeedback) et des publications (Post). Responsable : Dhia Eddine Mnajja."
  },
  "servers": [{ "url": "http://localhost:3004" }],
  "tags": [
    { "name": "Matches", "description": "Correspondances objets perdus / retrouvés" },
    { "name": "Feedbacks", "description": "Retours sur les correspondances" },
    { "name": "Matches — Métier", "description": "Matching automatique, cycle de vie, historique, suggestions, tableau de bord" },
    { "name": "Feedbacks — Métier", "description": "Précision du matching et rejet automatique (≥ 3 avis et < 50 % positifs). Un seul avis par utilisateur et par correspondance (409)." },
    { "name": "Posts", "description": "Publications liées à une correspondance" },
    { "name": "Posts — Métier", "description": "Publication réservée aux correspondances CONFIRMÉ / RESTITUÉ, cycle BROUILLON → PUBLIÉ → ARCHIVÉ, j'aime, vues, fil par popularité, génération automatique. Archivage automatique quand la correspondance est rejetée ; suppression en cascade avec la correspondance." }
  ],
  "paths": {
    "/api/matches": {
      "post": {
        "tags": ["Matches"], "summary": "Ajouter une correspondance",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatchInput" } } } },
        "responses": { "201": { "description": "Créée" }, "400": { "description": "Données invalides" }, "409": { "description": "Doublon" } }
      },
      "get": {
        "tags": ["Matches"], "summary": "Lister les correspondances (filtres, recherche, tri, pagination)",
        "description": "Réponse : data, count (sur la page), total, page, pages, limit. L'historique n'est pas renvoyé dans la liste.",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["PROPOSÉ", "CONFIRMÉ", "REJETÉ", "RESTITUÉ"] } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "minScore", "in": "query", "schema": { "type": "number" } },
          { "name": "q", "in": "query", "description": "Recherche texte dans lostItemId, foundItemId et notes", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["-score", "score", "-createdAt", "createdAt"], "default": "-score" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "Liste paginée" }, "400": { "description": "Tri invalide" } }
      }
    },
    "/api/matches/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Matches"], "summary": "Rechercher une correspondance par id", "responses": { "200": { "description": "Trouvée" }, "400": { "description": "Id invalide" }, "404": { "description": "Introuvable" } } },
      "put": {
        "tags": ["Matches"], "summary": "Modifier une correspondance (score recalculé)",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MatchInput" } } } },
        "responses": { "200": { "description": "Modifiée" }, "404": { "description": "Introuvable" } }
      },
      "delete": { "tags": ["Matches"], "summary": "Supprimer une correspondance", "responses": { "200": { "description": "Supprimée" }, "404": { "description": "Introuvable" } } }
    },
    "/api/matches/{id}/status": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "patch": {
        "tags": ["Matches — Métier"], "summary": "Changer le statut (cycle de vie PROPOSÉ → CONFIRMÉ → RESTITUÉ, ou REJETÉ)",
        "description": "Transitions autorisées : PROPOSÉ → CONFIRMÉ | REJETÉ ; CONFIRMÉ → RESTITUÉ | REJETÉ. REJETÉ et RESTITUÉ sont finaux. Confirmer une correspondance rejette automatiquement les autres propositions sur le même objet perdu ou retrouvé (champ autresRejetees).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["PROPOSÉ", "CONFIRMÉ", "REJETÉ", "RESTITUÉ"], "example": "CONFIRMÉ" }, "comment": { "type": "string", "example": "Propriétaire identifié", "description": "Enregistré dans l'historique" } } } } } },
        "responses": { "200": { "description": "Statut modifié" }, "400": { "description": "Statut invalide" }, "404": { "description": "Introuvable" }, "409": { "description": "Transition interdite ou objet déjà confirmé ailleurs" } }
      }
    },
    "/api/matches/{id}/history": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "tags": ["Matches — Métier"], "summary": "Historique des changements de statut (de, vers, date, commentaire)",
        "description": "Alimenté à la création, par PATCH /status, par PUT, et par les rejets automatiques (proposition concurrente, avis négatifs).",
        "responses": { "200": { "description": "Historique" }, "400": { "description": "Id invalide" }, "404": { "description": "Introuvable" } }
      }
    },
    "/api/matches/auto": {
      "post": {
        "tags": ["Matches — Métier"], "summary": "Matching automatique : le serveur calcule les 4 critères puis crée la correspondance",
        "description": "Catégorie : 100 si identique, sinon 0. Description : similarité des mots (coefficient de Dice, sans accents ni mots vides). Lieu : distance GPS (Haversine), 100 − 5 points par km. Date : 100 − 10 points par jour d'écart, 0 si trouvé avant d'être perdu. ?preview=true : calcule sans enregistrer.",
        "parameters": [{ "name": "preview", "in": "query", "schema": { "type": "boolean" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutoMatchInput" } } } },
        "responses": { "200": { "description": "Aperçu (preview=true)" }, "201": { "description": "Créée" }, "400": { "description": "Données invalides" }, "409": { "description": "Paire déjà existante" } }
      }
    },
    "/api/matches/stats": {
      "get": {
        "tags": ["Matches — Métier"], "summary": "Tableau de bord : total, score moyen, répartition par statut et par catégorie, taux de restitution",
        "responses": { "200": { "description": "Statistiques" } }
      }
    },
    "/api/matches/suggestions/{lostItemId}": {
      "get": {
        "tags": ["Matches — Métier"], "summary": "Meilleures correspondances pour un objet perdu (PROPOSÉ/CONFIRMÉ, triées par score, avec niveau FORT/MOYEN/FAIBLE)",
        "parameters": [
          { "name": "lostItemId", "in": "path", "required": true, "schema": { "type": "string", "example": "LOST-001" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 5, "maximum": 20 } }
        ],
        "responses": { "200": { "description": "Suggestions" } }
      }
    },
    "/api/feedbacks": {
      "post": {
        "tags": ["Feedbacks"], "summary": "Ajouter un feedback",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackInput" } } } },
        "responses": { "201": { "description": "Créé" } }
      },
      "get": {
        "tags": ["Feedbacks"], "summary": "Lister les feedbacks",
        "parameters": [{ "name": "matchId", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Liste" } }
      }
    },
    "/api/feedbacks/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Feedbacks"], "summary": "Rechercher un feedback par id", "responses": { "200": { "description": "Trouvé" } } },
      "put": {
        "tags": ["Feedbacks"], "summary": "Modifier un feedback",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackInput" } } } },
        "responses": { "200": { "description": "Modifié" } }
      },
      "delete": { "tags": ["Feedbacks"], "summary": "Supprimer un feedback", "responses": { "200": { "description": "Supprimé" } } }
    },
    "/api/feedbacks/stats": {
      "get": {
        "tags": ["Feedbacks — Métier"], "summary": "Précision globale du matching (avis positifs / total), note moyenne, par catégorie",
        "responses": { "200": { "description": "Statistiques" } }
      }
    },
    "/api/feedbacks/stats/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "description": "Id de la correspondance (matchId)", "schema": { "type": "string" } }],
      "get": {
        "tags": ["Feedbacks — Métier"], "summary": "Fiabilité d'une correspondance d'après ses avis (verdict FIABLE / MITIGÉ / DOUTEUX / INSUFFISANT)",
        "responses": { "200": { "description": "Statistiques" }, "404": { "description": "Correspondance introuvable" } }
      }
    },
    "/api/posts": {
      "post": {
        "tags": ["Posts"], "summary": "Ajouter une publication (créée en BROUILLON)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostInput" } } } },
        "responses": { "201": { "description": "Créée" }, "400": { "description": "Données invalides" }, "404": { "description": "Correspondance introuvable" }, "409": { "description": "Correspondance rejetée" } }
      },
      "get": {
        "tags": ["Posts"], "summary": "Lister les publications (filtres, recherche, pagination)",
        "parameters": [
          { "name": "matchId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["BROUILLON", "PUBLIÉ", "ARCHIVÉ"] } },
          { "name": "authorId", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "description": "Recherche dans le titre et le contenu", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "Liste paginée" } }
      }
    },
    "/api/posts/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Posts"], "summary": "Rechercher une publication par id (une publication PUBLIÉ compte une vue)", "responses": { "200": { "description": "Trouvée" }, "400": { "description": "Id invalide" }, "404": { "description": "Introuvable" } } },
      "put": {
        "tags": ["Posts"], "summary": "Modifier le titre, le contenu ou les tags",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostInput" } } } },
        "responses": { "200": { "description": "Modifiée" }, "404": { "description": "Introuvable" }, "409": { "description": "Publication archivée" } }
      },
      "delete": { "tags": ["Posts"], "summary": "Supprimer une publication", "responses": { "200": { "description": "Supprimée" }, "404": { "description": "Introuvable" } } }
    },
    "/api/posts/{id}/publish": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "patch": { "tags": ["Posts — Métier"], "summary": "Publier (BROUILLON → PUBLIÉ) — correspondance CONFIRMÉ ou RESTITUÉ uniquement", "responses": { "200": { "description": "Publiée" }, "409": { "description": "Pas un brouillon, ou correspondance non confirmée" } } }
    },
    "/api/posts/{id}/archive": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "patch": {
        "tags": ["Posts — Métier"], "summary": "Archiver (BROUILLON | PUBLIÉ → ARCHIVÉ)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reason": { "type": "string", "example": "Doublon" } } } } } },
        "responses": { "200": { "description": "Archivée" }, "409": { "description": "Déjà archivée" } }
      }
    },
    "/api/posts/{id}/like": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": {
        "tags": ["Posts — Métier"], "summary": "J'aime / je n'aime plus (bascule, un seul j'aime par utilisateur)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["userId"], "properties": { "userId": { "type": "string", "example": "USER-001" } } } } } },
        "responses": { "200": { "description": "liked, likesCount" }, "400": { "description": "userId manquant" }, "409": { "description": "Publication non publiée" } }
      }
    },
    "/api/posts/feed": {
      "get": {
        "tags": ["Posts — Métier"], "summary": "Fil des publications PUBLIÉ classées par popularité (j'aime × 3 + vues), avec leur correspondance",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }],
        "responses": { "200": { "description": "Fil" } }
      }
    },
    "/api/posts/from-match/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "description": "Id de la correspondance", "schema": { "type": "string" } },
        { "name": "publish", "in": "query", "description": "Publier directement si la correspondance est confirmée", "schema": { "type": "boolean" } }
      ],
      "post": {
        "tags": ["Posts — Métier"], "summary": "Générer automatiquement une publication (titre, contenu, tags) à partir d'une correspondance",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "authorId": { "type": "string", "example": "USER-002" } } } } } },
        "responses": { "201": { "description": "Générée" }, "404": { "description": "Correspondance introuvable" }, "409": { "description": "Correspondance rejetée" } }
      }
    },
    "/api/posts/stats": {
      "get": { "tags": ["Posts — Métier"], "summary": "Statistiques : total, par statut, total j'aime et vues, top 3", "responses": { "200": { "description": "Statistiques" } } }
    }
  },
  "components": {
    "schemas": {
      "MatchInput": {
        "type": "object",
        "required": ["lostItemId", "foundItemId", "category"],
        "properties": {
          "lostItemId": { "type": "string", "example": "LOST-001" },
          "foundItemId": { "type": "string", "example": "FOUND-001" },
          "category": { "type": "string", "enum": ["Accessoires", "Clés", "Électronique", "Documents", "Vêtements", "Portefeuille", "Autre"] },
          "criteria": {
            "type": "object",
            "properties": {
              "categoryScore": { "type": "number", "example": 100 },
              "descriptionScore": { "type": "number", "example": 80 },
              "locationScore": { "type": "number", "example": 90 },
              "dateScore": { "type": "number", "example": 70 }
            }
          },
          "status": { "type": "string", "enum": ["PROPOSÉ", "CONFIRMÉ", "REJETÉ", "RESTITUÉ"] },
          "notes": { "type": "string" }
        }
      },
      "ItemInput": {
        "type": "object",
        "required": ["id", "category", "description", "location", "date"],
        "properties": {
          "id": { "type": "string", "example": "LOST-101" },
          "category": { "type": "string", "enum": ["Accessoires", "Clés", "Électronique", "Documents", "Vêtements", "Portefeuille", "Autre"] },
          "description": { "type": "string", "example": "iPhone 13 bleu coque noire perdu à la cafétéria" },
          "location": { "type": "object", "properties": { "lat": { "type": "number", "example": 36.8992 }, "lng": { "type": "number", "example": 10.1894 } } },
          "date": { "type": "string", "format": "date", "example": "2026-10-20" }
        }
      },
      "AutoMatchInput": {
        "type": "object",
        "required": ["lost", "found"],
        "properties": {
          "lost": { "$ref": "#/components/schemas/ItemInput" },
          "found": { "$ref": "#/components/schemas/ItemInput" },
          "notes": { "type": "string" }
        }
      },
      "PostInput": {
        "type": "object",
        "required": ["matchId", "authorId", "title", "content"],
        "properties": {
          "matchId": { "type": "string" },
          "authorId": { "type": "string", "example": "USER-001" },
          "title": { "type": "string", "maxLength": 120, "example": "iPhone bleu retrouvé à la cafétéria" },
          "content": { "type": "string", "maxLength": 2000, "example": "Un iPhone 13 bleu avec coque noire a été retrouvé." },
          "tags": { "type": "array", "items": { "type": "string" }, "example": ["iphone", "cafeteria"] }
        }
      },
      "FeedbackInput": {
        "type": "object",
        "required": ["matchId", "userId", "isCorrect"],
        "properties": {
          "matchId": { "type": "string" },
          "userId": { "type": "string", "example": "USER-001" },
          "isCorrect": { "type": "boolean" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "comment": { "type": "string" }
        }
      }
    }
  }
}
